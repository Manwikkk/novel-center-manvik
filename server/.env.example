NODE_ENV=development
PORT=4000

# MySQL
# IMPORTANT: wrap values in double quotes if they contain # $ space or backslash,
# because dotenv treats a bare '#' as the start of an inline comment.
# e.g. DB_PASSWORD="my#secret"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=novel_center
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=replace_me_access_secret_min_32_chars_long_xx
JWT_REFRESH_SECRET=replace_me_refresh_secret_min_32_chars_long_xx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS - comma separated (exact browser Origin, e.g. https://your-frontend.com)
CORS_ORIGINS=http://localhost:3000,https://novelcenter.instabizweb.com

# Google OAuth (must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the client)
GOOGLE_CLIENT_ID=

# Storage adapter: local | gcs | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# GCS (only used when STORAGE_DRIVER=gcs)
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
# IMPORTANT: store the full key, escaping newlines as \n if you keep it on one line.
# Example: GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GCS_PRIVATE_KEY=
GCS_BUCKET=novel_center
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com

# S3 (only used when STORAGE_DRIVER=s3 - stub for future)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
